# TudlaAccounting settings. See the engine's README for what each one does.
TudlaAccounting.configure do |config|
  # --- Pages (mounted at <%= options[:mount_path] %>) ---
  # Engine controllers inherit from this controller, so its login and helpers apply.
  config.parent_controller = "::ApplicationController"
  # Whose books to show; nil shows a "no organization" page.
  config.current_organization = ->(controller) { controller.send(:current_organization) }
  # Who is acting, recorded on the audit trail: a record (labelled by name or email) or a string.
  # config.current_actor = ->(controller) { controller.send(:current_user) }
  # What each user may do: permission is :read, :record (drafts and accounts),
  # :post (posting, reversing, applying payments) or :administer (periods and setup).
  # config.authorize = ->(controller, permission) { controller.send(:current_user)&.admin? || permission == :read }

  # --- Books ---
  config.base_currency = "USD"
  config.time_zone = "UTC" # financial years and months are built in this zone
  # The accounts the books treat specially (receivables, payables, retained earnings,
  # exchange gains and losses) are marked by role on each organization's own accounts:
  # in the account form, a Role column in the chart import, or AccountsCreator's role:.
  # config.tax_basis = :cash # tax summary counts tax as invoices and bills are paid (default :accrual)
  # config.cash_account_codes = %w[1010] # cash for the cash flow statement (with sub-accounts)
  # or a callable given the organization, when charts differ (a bookkeeper's clients):
  # config.cash_account_codes = ->(organization) { organization.cash_account_codes }
  # config.organization_label = ->(organization) { organization.name } # names it in errors (default: class and id)
  # Journal numbers, given as entries are posted: one run per organization by default,
  # or :financial_year (restarting each year), or ->(entry) { "series" }. Shown as "#42".
  # config.entry_number_series = :financial_year
  # config.entry_number_format = "JE-%{series}-%<number>05d" # or ->(entry) { ... }
  # Attachments on entries (with Active Storage): what may be attached, and how big.
  # config.attachment_content_types += %w[application/zip]
  # config.attachment_max_size = 20.megabytes

  # --- Receivables and payables (off until an account is marked receivable or payable) ---
  # config.carrying_amount_sources = {
  #   "Invoice" => :receivable, "Bill" => :payable,
  #   "Payment" => :receipt, "Disbursement" => :disbursement,
  #   "CreditNote" => :credit_note, "SupplierCredit" => :supplier_credit,
  #   "Refund" => :refund, "SupplierRefund" => :supplier_refund
  # }
  # config.due_date_method = :due_date
  # config.related_party_method = :customer

  # --- Foreign exchange ---
  # config.forex_rate_provider = TudlaAccounting::RbaForexRateProvider.new # or ->(from:, to:, date:) { rate }
end

# Entries from your own records (Entry hashes; one entry per record by default):
# TudlaAccounting.register_entry_source("Invoice", ->(invoice) { { organization_type: ..., details: [...] } })

# Recurring entries are made by TudlaAccounting::RecurringEntriesJob: schedule it daily, e.g. in
# config/recurring.yml (Solid Queue) or with cron.

# Reports download as CSV; add gem "caxlsx" to the Gemfile to offer Excel workbooks too.

# React to changes to the books once they commit:
# TudlaAccounting.subscribe("entry.posted") { |event| LedgerSyncJob.perform_later(event.subject_id) }

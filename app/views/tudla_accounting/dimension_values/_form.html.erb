<%# locals: (dimension:, value:) %>
<%= form_with model: value, scope: :dimension_value, url: (value.persisted? ? dimension_dimension_value_path(dimension, value) : dimension_dimension_values_path(dimension)),
              class: "tc-card tc-card-body space-y-4 max-w-xl" do |form| %>
  <div class="grid gap-4 sm:grid-cols-3">
    <%= tc_field form, :code, required: true %>
    <div class="sm:col-span-2"><%= tc_field form, :name, required: true %></div>
  </div>
  <label class="flex items-center gap-2 text-sm"><%= form.check_box :active %> Active (offered on entry lines)</label>
  <div class="flex gap-2"><%= form.submit "Save value", class: "tc-btn" %><%= link_to "Cancel", dimensions_path, class: "tc-btn tc-btn-ghost" %></div>
<% end %>

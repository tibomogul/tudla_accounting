<%= tc_page_header "API tokens", subtitle: "For other systems to read and record in these books through the JSON API" do %>
  <%= link_to "Setup", setup_path, class: "tc-btn tc-btn-ghost" %>
  <%= link_to "New token", new_api_token_path, class: "tc-btn" %>
<% end %>

<div class="tc-card overflow-x-auto">
  <table class="tc-table">
    <thead><tr><th>Name</th><th>Token</th><th>Can</th><th>Issued</th><th>Last used</th><th>Expires</th><th>Status</th><th><span class="sr-only">Revoke</span></th></tr></thead>
    <tbody>
      <% if @tokens.empty? %>
        <tr><td colspan="8" class="tc-muted text-center">No tokens yet.</td></tr>
      <% end %>
      <% @tokens.each do |token| %>
        <tr data-token class="<%= "tc-muted" unless token.active? %>">
          <td><%= token.name %></td>
          <td><code class="text-xs"><%= token.masked %></code></td>
          <td><%= token.permissions.join(", ") %></td>
          <td class="whitespace-nowrap"><%= tc_date(token.created_at) %><% if token.created_by %> <span class="tc-muted text-xs">by <%= token.created_by %></span><% end %></td>
          <td class="whitespace-nowrap"><%= token.last_used_at ? token.last_used_at.in_time_zone(TudlaAccounting.configuration.time_zone).strftime("%-d %b %Y %H:%M") : "Never" %></td>
          <td class="whitespace-nowrap"><%= tc_date(token.expires_on) || "—" %></td>
          <td>
            <% if token.revoked? %><%= tc_badge "Revoked #{tc_date(token.revoked_at)}", tone: :danger %>
            <% elsif token.expired? %><%= tc_badge "Expired", tone: :warning %>
            <% else %><%= tc_badge "Active", tone: :success %><% end %>
          </td>
          <td class="text-right">
            <% unless token.revoked? %>
              <%= button_to "Revoke", revoke_api_token_path(token), class: "tc-btn tc-btn-danger tc-btn-sm",
                            form: { data: { controller: "confirm", confirm_message_value: "Revoke #{token.name}? Anything using it stops working.", action: "submit->confirm#ask" } } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<p class="tc-hint mt-4">Send a token as <code>Authorization: Bearer tudla_…</code>. What a token does is on the activity log under its name.</p>

<%= tc_page_header "Balance check", subtitle: "Stored balances compared with the posted entries and the opening balances" %>

<% fields = { starting_amount_cents: "Opening", current_amount_cents: "Movement", ending_amount_cents: "Closing", missing: "Not stored" } %>
<% money = ->(cents) { cents.nil? ? "—" : tc_money(Money.new(cents, accounting_organization.currency)) } %>

<% if @differences.empty? %>
  <div class="tc-alert tc-alert-success" role="status"><span>Every stored balance agrees with the posted entries.</span></div>
<% else %>
  <div class="space-y-4">
    <div class="tc-alert tc-alert-warning" role="alert">
      <span><%= pluralize(@differences.size, "difference") %> between the stored balances and the posted entries. Rebuilding rewrites the stored balances to match; posted entries are not changed.</span>
    </div>
    <section class="tc-card overflow-x-auto" aria-label="Differences">
      <table class="tc-table">
        <thead><tr><th>Period</th><th>Account</th><th>Figure</th><th class="tc-num">Stored</th><th class="tc-num">Expected</th></tr></thead>
        <tbody>
          <% @differences.each do |difference| %>
            <tr>
              <td><%= difference.period.root? ? "Year #{tc_period_label(difference.period)}" : tc_period_label(difference.period) %></td>
              <td><span class="font-mono tc-muted"><%= difference.account.code %></span> <%= difference.account.name %></td>
              <td><%= fields.fetch(difference.field) %></td>
              <td class="tc-num"><%= money.call(difference.stored) %></td>
              <td class="tc-num"><%= money.call(difference.expected) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
    <%= button_to "Rebuild balances", setup_balances_path, class: "tc-btn",
                  form: { data: { controller: "confirm", confirm_message_value: "Rewrite the stored balances from the posted entries?", action: "submit->confirm#ask" } } %>
  </div>
<% end %>

<p class="mt-6 text-sm"><%= link_to "← Back to setup", setup_path, class: "underline" %></p>

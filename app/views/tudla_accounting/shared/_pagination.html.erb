<%# locals: (paginator:, param: :page) %>
<% if paginator.total_pages > 1 %>
  <% page_url = ->(number) { "#{request.path}?#{request.query_parameters.merge(param.to_s => number).to_query}" } %>
  <nav class="tc-pagination mt-4" aria-label="Pagination">
    <%= link_to "‹ Previous", (paginator.previous_page ? page_url.call(paginator.previous_page) : "#"), class: "tc-page", aria: { disabled: (true unless paginator.previous_page) } %>
    <% paginator.window.each do |number| %>
      <% if number %>
        <%= link_to number, page_url.call(number), class: "tc-page", aria: { current: ("page" if number == paginator.page) } %>
      <% else %>
        <span class="tc-page" aria-hidden="true">…</span>
      <% end %>
    <% end %>
    <%= link_to "Next ›", (paginator.next_page ? page_url.call(paginator.next_page) : "#"), class: "tc-page", aria: { disabled: (true unless paginator.next_page) } %>
  </nav>
<% end %>

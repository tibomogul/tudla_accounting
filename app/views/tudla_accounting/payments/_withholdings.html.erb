<%# locals: (codes:, contact:, currency:, cash_follows_tax: false, received: true, start: nil) %>
<%# The tax withheld from a payment: by a customer, as their certificate says (three rows, for
    a payment covering more than one kind of income), or by us from a supplier, under a
    code withheld on payment (one row), the tax worked out from the amount as it's typed. %>
<% rows = received ? 3 : 1 %>
<div class="tc-card overflow-x-auto" data-withholdings>
  <h2 class="tc-card-body tc-card-title pb-0"><%= received ? "Tax withheld by #{contact.name}" : "Tax withheld from #{contact.name}" %></h2>
  <table class="tc-table">
    <thead><tr><th>Code</th><th class="tc-num">Tax withheld (<%= currency %>)</th><th class="tc-num"><%= received ? "Income" : "Withheld from" %> (<%= currency %>)</th></tr></thead>
    <tbody>
      <% rows.times do |index| %>
        <% typed = params.dig(:payment, :withholdings, index.to_s) || (start if index.zero?) %>
        <% chosen = typed ? typed[:withholding_code_id] : (contact.default_withholding_code_id if index.zero?) %>
        <tr data-withholding-row>
          <td><%= select_tag "payment[withholdings][#{index}][withholding_code_id]",
                             options_for_select(codes.map { |code| [ "#{code.label} #{code.name}", code.id, { data: { rate: code.rate.to_s } } ] }, chosen.to_s),
                             include_blank: "Choose a code", class: "tc-input", aria: { label: "Withholding code #{index + 1}" },
                             data: (received ? {} : { action: "change->withheld-cash#baseTyped" }) %></td>
          <td class="w-40"><%= text_field_tag "payment[withholdings][#{index}][withheld]", typed && typed[:withheld], inputmode: "decimal", class: "tc-input tc-num", aria: { label: "Tax withheld #{index + 1}" },
                                data: { withheld_cash_target: "withheld", action: "input->withheld-cash#recalculate" } %></td>
          <td class="w-40"><%= text_field_tag "payment[withholdings][#{index}][base]", typed && typed[:base], inputmode: "decimal", class: "tc-input tc-num", aria: { label: "#{received ? 'Income' : 'Withheld from'} #{index + 1}" },
                                data: (received ? {} : { withheld_cash_target: "base", action: "input->withheld-cash#baseTyped" }) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if received %>
    <p class="tc-card-body tc-hint">Type the tax as the customer's certificate gives it. Leave the income blank to work it out from the code's rate. The cash and the tax together can be applied to invoices; what's left of the cash can be refunded, the tax can't.<%= " The cash received comes down by the tax as you type it, unless you've changed the cash yourself." if cash_follows_tax %></p>
  <% else %>
    <% no_abn = TudlaAccounting::Jurisdictions.on?(accounting_organization, :payee_payments) %>
    <p class="tc-card-body tc-hint" data-withholding-hint><%= no_abn ? "For a supplier who hasn't quoted an ABN by the time you pay." : "For tax withheld from the supplier when you pay them." %> Type what the tax is withheld from (the amount you're settling); the tax is worked out at the code's rate, or type it yourself. The cash and the tax together settle their bills, and the tax goes to the code's account, to pay <%= no_abn ? "the ATO" : "the tax office" %>.<%= " The cash paid comes down by the tax as it's worked out, unless you've changed the cash yourself." if cash_follows_tax %><%= " Leave it blank if they've quoted an ABN." if no_abn %></p>
  <% end %>
</div>

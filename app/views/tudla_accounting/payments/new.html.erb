<% received = @payment.received? %>
<%= tc_page_header (received ? "Record a payment received" : "Record a payment made") %>

<% contacts = TudlaAccounting::Contact.where(organization: accounting_organization).active.then { |scope| received ? scope.customers : scope.suppliers }.order(Arel.sql("LOWER(name)")) %>
<%= form_with url: new_payment_path, method: :get, class: "tc-card tc-card-body mb-4 flex flex-wrap items-end gap-3" do |form| %>
  <%= hidden_field_tag :kind, @payment.kind %>
  <div class="grow"><%= form.label :contact_id, received ? "Customer" : "Supplier", class: "tc-label" %>
    <%= form.select :contact_id, contacts.map { |contact| [ contact.name, contact.id ] }, { include_blank: "Choose #{received ? 'a customer' : 'a supplier'}", selected: @payment.contact_id },
                    class: "tc-input", required: true %></div>
  <%= form.submit (@payment.contact ? "Change" : "Show what they owe"), class: "tc-btn tc-btn-secondary", name: nil %>
<% end %>

<% if @payment.contact %>
  <%= form_with url: payments_path, scope: :payment, class: "space-y-4" do |form| %>
    <% if @payment.errors.any? %>
      <div class="tc-alert tc-alert-danger" role="alert"><ul class="list-disc pl-4"><% @payment.errors.full_messages.uniq.each do |message| %><li><%= message %></li><% end %></ul></div>
    <% end %>
    <%= form.hidden_field :kind, value: @payment.kind %>
    <%= form.hidden_field :contact_id, value: @payment.contact_id %>
    <div class="tc-card tc-card-body grid gap-4 sm:grid-cols-4">
      <div><%= form.label :paid_on, "Date", class: "tc-label" %><%= form.date_field :paid_on, value: @payment.paid_on, required: true, class: "tc-input" %></div>
      <div><%= form.label :account_id, received ? "Into" : "From", class: "tc-label" %>
        <%= form.select :account_id, payment_accounts.map { |account| [ account.code_with_name, account.id ] }, { selected: @payment.account_id, include_blank: "Choose an account" }, class: "tc-input", required: true %></div>
      <div><%= form.label :amount, "Amount (#{accounting_organization.currency})", class: "tc-label" %>
        <%= form.text_field :amount, value: (@payment.amount_cents.to_i.positive? ? @payment.amount.format(symbol: false, thousands_separator: "") : params.dig(:payment, :amount)), inputmode: "decimal", required: true, class: "tc-input tc-num" %></div>
      <div><%= form.label :reference, class: "tc-label" %><%= form.text_field :reference, value: @payment.reference, placeholder: "Bank reference", class: "tc-input" %></div>
    </div>

    <div class="tc-card overflow-x-auto">
      <h2 class="tc-card-body tc-card-title pb-0">Apply it to</h2>
      <% if @open.any? %>
        <table class="tc-table">
          <thead><tr><th>Number</th><th>Date</th><th>Due</th><th class="tc-num">Still owed</th><th class="tc-num">Apply</th></tr></thead>
          <tbody>
            <% @open.each do |document| %>
              <tr data-open-document>
                <td><%= link_to document.number_label, document_path(document), class: "underline" %></td>
                <td class="whitespace-nowrap"><%= tc_date(document.issued_on) %></td>
                <td class="whitespace-nowrap"><%= tc_date(document.due_on) %></td>
                <td class="tc-num"><%= tc_money(document.amount_due) %></td>
                <td class="w-36"><%= text_field_tag "payment[applications][#{document.id}]", (@applied[document.id] && Money.new(@applied[document.id], accounting_organization.currency).format(symbol: false, thousands_separator: "")),
                                                    inputmode: "decimal", class: "tc-input tc-num", aria: { label: "Apply to #{document.number_label}" } %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="tc-card-body tc-muted text-sm">Nothing is owed <%= received ? "by" : "to" %> <%= @payment.contact.name %>; the payment is kept as a credit to apply later.</p>
      <% end %>
      <p class="tc-card-body tc-hint">Whatever isn't applied stays as a credit for <%= @payment.contact.name %>.</p>
    </div>
    <div class="tc-card tc-card-body space-y-3">
      <div><%= form.label :notes, class: "tc-label" %><%= form.text_area :notes, value: @payment.notes, rows: 2, class: "tc-input" %></div>
      <label class="flex items-center gap-2 text-sm">
        <%= form.check_box :email_it, { checked: params.dig(:payment, :email_it) == "1" }, "1", "0" %>
        Email <%= received ? "a receipt" : "a payment notice" %> to <%= @payment.contact.name %><%= @payment.contact.email ? " (#{@payment.contact.email})" : " (they have no email address yet)" %>
      </label>
    </div>
    <div class="flex gap-2">
      <%= form.submit "Record payment", class: "tc-btn" %>
      <%= link_to "Cancel", (received ? received_payments_path : paid_payments_path), class: "tc-btn tc-btn-ghost" %>
      <span class="tc-hint self-center">It is posted straight away; after that it can only be voided.</span>
    </div>
  <% end %>
<% end %>

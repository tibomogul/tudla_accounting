<%= tc_page_header "Dimensions", subtitle: "Ways to analyse the books beyond accounts: departments, projects, locations" do %>
  <%= link_to "New dimension", new_dimension_path, class: "tc-btn" %>
<% end %>

<% if @dimensions.empty? %>
  <div class="tc-card tc-card-body text-center">
    <p class="tc-muted">No dimensions yet. Add one (say Department), give it values, then tag entry lines with them to see profit and loss by each.</p>
  </div>
<% end %>

<div class="space-y-4">
  <% @dimensions.each do |dimension| %>
    <section class="tc-card" aria-labelledby="<%= dom_id(dimension) %>">
      <div class="tc-card-body pb-0 flex flex-wrap items-center justify-between gap-2">
        <h2 id="<%= dom_id(dimension) %>" class="tc-card-title"><%= dimension.label %><% unless dimension.active? %> <%= tc_badge "Inactive" %><% end %></h2>
        <div class="flex gap-2">
          <%= link_to "Edit", edit_dimension_path(dimension), class: "tc-btn tc-btn-ghost tc-btn-sm" %>
          <%= link_to "Add value", new_dimension_dimension_value_path(dimension), class: "tc-btn tc-btn-secondary tc-btn-sm" %>
        </div>
      </div>
      <% if dimension.dimension_values.empty? %>
        <p class="tc-card-body tc-muted text-sm">No values yet.</p>
      <% else %>
        <table class="tc-table">
          <thead><tr><th>Code</th><th>Name</th><th></th></tr></thead>
          <tbody>
            <% dimension.dimension_values.each do |value| %>
              <tr>
                <td class="font-mono"><%= link_to value.code, edit_dimension_dimension_value_path(dimension, value), class: "underline" %></td>
                <td><%= value.name %></td>
                <td class="text-right"><% unless value.active? %><%= tc_badge "Inactive" %><% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </section>
  <% end %>
</div>

<p class="mt-6"><%= link_to "← Back to setup", setup_path, class: "tc-btn tc-btn-ghost" %></p>

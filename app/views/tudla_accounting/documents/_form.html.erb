<%# locals: (document:) %>
<% currency = Money::Currency.new(accounting_organization.currency) %>
<% sales = document.sales? %>
<% lines = document.lines.to_a %>
<% account_options = document_accounts(document).map { |account| [ account_option_label(account), account.id ] } %>
<% tax_options = document_tax_codes(document).map { |code| [ code.label, code.id, { data: { rate: code.rate.to_s } } ] } %>
<% contacts = document_contacts(document) %>
<% dimensions = entry_dimensions(lines) %>
<% before_amount = 5 + dimensions.size %>
<%= form_with model: document, scope: :document, url: (document.persisted? ? document_path(document) : documents_path),
              class: "space-y-4", data: { controller: "document-lines", document_lines_exponent_value: currency.exponent } do |form| %>
  <% if document.errors.any? %>
    <div class="tc-alert tc-alert-danger" role="alert">
      <ul class="list-disc pl-4"><% document.errors.full_messages.uniq.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>
  <%= form.hidden_field :kind if document.new_record? %>

  <div class="tc-card tc-card-body grid gap-4 sm:grid-cols-6">
    <div class="sm:col-span-3 space-y-1">
      <%= form.label :contact_id, sales ? "Customer" : "Supplier", class: "tc-label" %>
      <%= form.select :contact_id, contacts.map { |contact| [ contact.name, contact.id, { data: { terms: contact.payment_terms_days, account: contact.default_account_id, tax: contact.default_tax_code_id } } ] },
                      { include_blank: "Choose #{sales ? 'a customer' : 'a supplier'}" }, required: true, class: "tc-input",
                      data: { document_lines_target: "contact", action: "change->document-lines#contactChanged" } %>
      <% if tc_can?(:record) %><p class="tc-hint">Not listed? <%= link_to "Add a contact", new_contact_path(kind: sales ? "customer" : "supplier"), class: "underline", target: "_blank" %>, then reload.</p><% end %>
    </div>
    <div class="sm:col-span-3"><%= tc_field form, :reference, label: sales ? "Their order number" : "Supplier's invoice number", placeholder: "Optional" %></div>
    <div class="sm:col-span-2"><%= tc_field form, :issued_on, as: :date_field, label: "Date", required: true, data: { document_lines_target: "issued", action: "change->document-lines#contactChanged" } %></div>
    <div class="sm:col-span-2"><%= tc_field form, :due_on, as: :date_field, label: "Due", data: { document_lines_target: "due" } %></div>
    <% if document.credit? %>
      <% charges = TudlaAccounting::Document.where(organization: accounting_organization, kind: sales ? "sales_invoice" : "bill").approved.with_open_cents
                     .where(contact: document.contact_id ? document.contact_id : contacts.select(:id)).order(issued_on: :desc).limit(200).includes(:contact).to_a %>
      <% charges = charges.select { |charge| charge.amount_due.positive? || charge.id == document.credited_document_id } %>
      <div class="sm:col-span-2"><%= tc_field form, :credited_document_id, as: :select, label: "Apply to",
                                              choices: [ [ "Nothing yet (a credit to apply later)", "" ] ] + charges.map { |charge| [ "#{charge.number_label} – #{charge.contact.name} (#{charge.amount_due.format} due)", charge.id ] } %></div>
    <% end %>
  </div>

  <div class="tc-card overflow-x-auto">
    <table class="tc-table">
      <thead>
        <tr><th>Description</th><th class="tc-num">Quantity</th><th class="tc-num">Unit price</th><th>Account</th><th>Tax</th><% dimensions.each do |dimension, _values| %><th><%= dimension.name %></th><% end %><th class="tc-num">Amount (<%= currency.iso_code %>)</th><th><span class="sr-only">Remove</span></th></tr>
      </thead>
      <tbody data-document-lines-target="lines">
        <% lines.each_with_index do |line, index| %>
          <%= render "tudla_accounting/documents/line", line: line, index: index, account_options: account_options, tax_options: tax_options, dimensions: dimensions %>
        <% end %>
      </tbody>
      <tfoot>
        <tr><td colspan="<%= before_amount + 2 %>"><button type="button" class="tc-btn tc-btn-secondary tc-btn-sm" data-action="document-lines#add">Add line</button></td></tr>
        <tr><td colspan="<%= before_amount %>" class="text-right">Subtotal</td><td class="tc-num" data-document-lines-target="subtotal"></td><td></td></tr>
        <tr class="tc-muted"><td colspan="<%= before_amount %>" class="text-right">Tax</td><td class="tc-num" data-document-lines-target="taxTotal"></td><td></td></tr>
        <tr class="font-semibold"><td colspan="<%= before_amount %>" class="text-right">Total</td><td class="tc-num" data-document-lines-target="total"></td><td></td></tr>
      </tfoot>
    </table>
  </div>
  <label class="flex items-center gap-2 text-sm">
    <%= form.check_box :tax_inclusive, data: { document_lines_target: "inclusive", action: "change->document-lines#recalculate" } %>
    Prices include the tax
  </label>
  <div class="tc-card tc-card-body"><%= tc_field form, :notes, as: :text_area, rows: 3, label: "Notes", hint: sales ? "Printed on the document: payment details, thanks..." : "For your own records" %></div>

  <template data-document-lines-target="template">
    <%= render "tudla_accounting/documents/line", line: TudlaAccounting::DocumentLine.new(quantity: 1), index: "NEW_LINE", account_options: account_options, tax_options: tax_options, dimensions: dimensions %>
  </template>

  <div class="flex flex-wrap gap-2">
    <%= form.submit "Save draft", class: "tc-btn tc-btn-secondary" %>
    <% if tc_can?(:post) %>
      <%= form.submit "Save and approve", name: "approve", class: "tc-btn" %>
    <% end %>
    <span class="tc-hint self-center">Approving numbers and posts it; after that it can only be voided.</span>
    <%= link_to "Cancel", (document.persisted? ? document_path(document) : (sales ? sales_documents_path : purchase_documents_path)), class: "tc-btn tc-btn-ghost" %>
  </div>
<% end %>

<%# locals: (document:) %>
<%# The document as it prints: on paper (or a PDF) it is all that shows. %>
<% currency = document.currency %>
<% registration = document.tax_registration %>
<% tax_name = registration&.tax_name || tc_t("tax") %>
<article class="tc-card tc-card-body space-y-6" data-document aria-label="<%= document.title %>">
  <header class="flex flex-wrap justify-between gap-6">
    <div class="whitespace-pre-line text-sm"><%= TudlaAccounting.configuration.document_header_for(document.organization) %><% if document.sales? && registration&.number %><p data-seller-tax-number><%= registration.label %> <%= registration.number %></p><% end %></div>
    <div class="text-right">
      <h2 class="text-2xl font-bold tracking-tight"><%= document.printed_title(registration) %><%= tc_t("void") if document.void? %></h2>
      <dl class="mt-2 grid grid-cols-[auto_auto] justify-end gap-x-4 gap-y-1 text-sm">
        <% if document.number_label %><dt class="tc-muted"><%= tc_t(".number") %></dt><dd><%= document.number_label %></dd><% end %>
        <dt class="tc-muted"><%= tc_t(".date") %></dt><dd><%= tc_date(document.issued_on) %></dd>
        <% if document.due_on && !document.credit? %><dt class="tc-muted"><%= tc_t(".due") %></dt><dd><%= tc_date(document.due_on) %></dd><% end %>
        <% if document.reference %><dt class="tc-muted"><%= tc_t(document.sales? ? ".your_reference" : ".their_number") %></dt><dd><%= document.reference %></dd><% end %>
        <% if document.credited_document %><dt class="tc-muted"><%= tc_t(".credits") %></dt><dd><%= document.credited_document.number_label %></dd><% end %>
      </dl>
    </div>
  </header>

  <section class="text-sm" aria-label="<%= tc_t(document.sales? ? ".to" : ".from") %>">
    <p class="tc-muted"><%= tc_t(document.sales? ? ".to" : ".from") %></p>
    <p class="font-semibold"><%= document.contact.name %></p>
    <% if document.contact.full_address %><p class="whitespace-pre-line"><%= document.contact.full_address %></p><% end %>
    <% if document.contact.tax_number %><p><%= registration ? registration.contact_label(document.contact.tax_number) : tc_t("tax_number") %> <%= document.contact.tax_number %></p><% end %>
  </section>

  <table class="tc-table">
    <thead>
      <tr><th><%= tc_t(".description") %></th><th class="tc-num"><%= tc_t(".quantity") %></th><th class="tc-num"><%= tc_t(".unit_price") %></th><th><%= tax_name %></th><th class="tc-num"><%= tc_t(".amount", currency: currency) %></th></tr>
    </thead>
    <tbody>
      <% document.lines.each do |line| %>
        <tr>
          <td><%= line.description %></td>
          <td class="tc-num"><%= document_quantity(line.quantity) %></td>
          <td class="tc-num"><%= tc_money(line.unit_price) %></td>
          <td><%= document_line_tax(line, registration) %></td>
          <td class="tc-num"><%= tc_money(line.amount) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr><td colspan="4" class="text-right"><%= document.tax_inclusive? ? (registration ? tc_t(".total_excluding", tax: tax_name) : tc_t(".total_excluding_tax")) : tc_t(".subtotal") %></td><td class="tc-num"><%= tc_money(document.subtotal) %></td></tr>
      <tr><td colspan="4" class="text-right"><%= document.tax_inclusive? ? tc_t(".tax_included", tax: tax_name) : tax_name %></td><td class="tc-num"><%= tc_money(document.tax) %></td></tr>
      <tr class="font-semibold"><td colspan="4" class="text-right"><%= tc_t(".total") %></td><td class="tc-num"><%= tc_money(document.total) %></td></tr>
      <% if document.withheld_cents.positive? %>
        <% document.lines.select(&:withholding_code).group_by(&:withholding_code).each do |code, lines| %>
          <tr data-withheld><td colspan="4" class="text-right"><%= tc_t(".less_withheld", code: code.label) %></td><td class="tc-num"><%= tc_money(Money.new(-lines.sum(&:withheld_cents), currency)) %></td></tr>
        <% end %>
        <tr class="font-semibold"><td colspan="4" class="text-right"><%= tc_t(document.credit? ? ".credit" : ".amount_payable") %></td><td class="tc-num"><%= tc_money(document.payable) %></td></tr>
      <% end %>
      <% if document.approved? && !document.credit? && document.amount_due != document.payable %>
        <tr><td colspan="4" class="text-right"><%= tc_t(".paid_or_credited") %></td><td class="tc-num"><%= tc_money(document.amount_due - document.payable) %></td></tr>
        <tr class="font-semibold"><td colspan="4" class="text-right"><%= tc_t(".amount_due") %></td><td class="tc-num"><%= tc_money(document.amount_due) %></td></tr>
      <% end %>
    </tfoot>
  </table>

  <% if document.notes && document.sales? %><p class="whitespace-pre-line text-sm"><%= document.notes %></p><% end %>
</article>
<% if document.notes && document.purchases? %><p class="tc-card tc-card-body mt-4 whitespace-pre-line text-sm"><span class="tc-muted"><%= tc_t(".notes") %></span> <%= document.notes %></p><% end %>

<%# locals: (line:, index:, account_options:, tax_options:, dimensions:) %>
<% name = ->(field) { "document[lines][#{index}][#{field}]" } %>
<tr data-document-lines-target="line" <%= "hidden" if line.marked_for_destruction? %>>
  <td class="min-w-56">
    <% if line.persisted? %><input type="hidden" name="<%= name.call(:id) %>" value="<%= line.id %>"><% end %>
    <input type="hidden" name="<%= name.call(:_destroy) %>" value="<%= line.marked_for_destruction? ? 1 : 0 %>" data-document-lines-target="destroy">
    <%= text_field_tag name.call(:description), line.description, maxlength: 255, placeholder: "What it's for", class: "tc-input", aria: { label: "Description" } %>
  </td>
  <td class="w-24"><%= text_field_tag name.call(:quantity), document_quantity(line.quantity || 1), inputmode: "decimal", class: "tc-input tc-num", aria: { label: "Quantity" },
                                      data: { document_lines_target: "quantity", action: "input->document-lines#recalculate" } %></td>
  <td class="w-32"><%= text_field_tag name.call(:unit_price), document_price(line), inputmode: "decimal", class: "tc-input tc-num", aria: { label: "Unit price" },
                                      data: { document_lines_target: "price", action: "input->document-lines#recalculate" } %></td>
  <td class="min-w-48"><%= select_tag name.call(:account_id), options_for_select(account_options, line.account_id), include_blank: "Choose an account", class: "tc-input",
                                      aria: { label: "Account" }, data: { document_lines_target: "account" } %></td>
  <td class="min-w-32"><%= select_tag name.call(:tax_code_id), options_for_select(tax_options, line.tax_code_id), include_blank: "No tax", class: "tc-input", aria: { label: "Tax" },
                                      data: { document_lines_target: "tax", action: "change->document-lines#recalculate" } %></td>
  <% dimensions.each do |dimension, values| %>
    <td class="min-w-32"><%= select_tag "#{name.call(:dimensions)}[#{dimension.id}]", options_for_select(values, line.dimension_value_for(dimension)&.id), include_blank: "—",
                                        class: "tc-input", aria: { label: dimension.name } %></td>
  <% end %>
  <td class="tc-num whitespace-nowrap" data-document-lines-target="amount"></td>
  <td class="text-right"><button type="button" class="tc-btn tc-btn-ghost tc-btn-sm" data-action="document-lines#remove" aria-label="Remove line">✕</button></td>
</tr>

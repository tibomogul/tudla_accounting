<%= tc_page_header "Financial years", subtitle: "Each year is split into months; entries post to the month containing their date" do %>
  <% if tc_can?(:administer) %><%= link_to "New financial year", new_period_path, class: "tc-btn" %><% end %>
<% end %>

<% if @years.empty? %>
  <div class="tc-card tc-card-body text-center">
    <p class="tc-muted">No financial years yet. Entries can only be posted once a year covers their date.</p>
    <% if tc_can?(:administer) %><p class="mt-4"><%= link_to "Create the first year", new_period_path, class: "tc-btn" %></p><% end %>
  </div>
<% else %>
  <div class="tc-card overflow-x-auto">
    <table class="tc-table">
      <thead><tr><th>Year</th><th>From</th><th>To</th><th>Months</th><th></th></tr></thead>
      <tbody>
        <% @years.each do |year| %>
          <tr>
            <td class="font-semibold"><%= link_to tc_period_label(year), period_path(year) %></td>
            <td><%= tc_date(year.from_date) %></td>
            <td><%= tc_date(year.thru_date) %></td>
            <td><%= year.children_count %></td>
            <td class="text-right">
              <% if year.closed? %><%= tc_badge "Closed", tone: :warning %><% end %>
              <% if year.includes_date?(Time.current) %><%= tc_badge "Current", tone: :primary %><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

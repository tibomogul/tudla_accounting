<%= tc_page_header "Withholding code #{@withholding_code.code}", subtitle: @withholding_code.name do %>
  <% unless @withholding_code.used? %>
    <%= button_to "Delete", withholding_code_path(@withholding_code), method: :delete, class: "tc-btn tc-btn-danger",
                  form: { data: { controller: "confirm", confirm_message_value: "Delete #{@withholding_code.code}?", action: "submit->confirm#ask" } } %>
  <% end %>
<% end %>
<% if @withholding_code.used? %><p class="tc-hint mb-4">This code is in use, so it can't be deleted; make it inactive to stop offering it. Once tax is posted under it, its code, rate and accounts can't change either.</p><% end %>
<%= render "form", withholding_code: @withholding_code %>

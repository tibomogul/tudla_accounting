<%#
  TudlaAccounting Engine Landing Page
  ============================================================
  This view uses pure Tailwind CSS v4 utility classes with
  --tc-* CSS custom properties defined in engine.css.
  No DaisyUI component classes are used.

  To customize: copy this file to your host application at:
    app/views/tudla_accounting/pages/index.html.erb
  Rails will automatically use your copy instead of this one.
  ============================================================
%>
<div class="min-h-screen bg-[var(--tc-bg)] text-[var(--tc-text)] transition-colors duration-200">

  <%# ── Navbar ─────────────────────────────────────────────── %>
  <nav class="sticky top-0 z-50 bg-[var(--tc-surface)] border-b border-[var(--tc-border)]">
    <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
      <span class="text-lg font-bold tracking-tight">
        <span style="color: var(--tc-primary)">Tibo</span>Core
      </span>
      <div class="hidden md:flex items-center gap-6 text-sm font-medium text-[var(--tc-text-muted)]">
        <a href="#features" class="hover:text-[var(--tc-text)] transition-colors">Features</a>
        <a href="#stack"    class="hover:text-[var(--tc-text)] transition-colors">Stack</a>
        <a href="#start"    class="hover:text-[var(--tc-text)] transition-colors">Get Started</a>
        <a href="<%= main_app.root_path %>" class="hover:text-[var(--tc-text)] transition-colors font-semibold" style="color: var(--tc-primary)">App ↗</a>
      </div>
      <a href="https://github.com/tibomogul/tudla_accounting"
         target="_blank" rel="noopener"
         class="text-[var(--tc-text-muted)] hover:text-[var(--tc-text)] transition-colors"
         aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-5 fill-current" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
    </div>
  </nav>

  <%# ── Hero ───────────────────────────────────────────────── %>
  <section class="bg-[var(--tc-bg-subtle)] border-b border-[var(--tc-border)]">
    <div class="max-w-3xl mx-auto px-6 py-24 text-center">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase px-3 py-1 rounded-full border border-[var(--tc-border)] text-[var(--tc-text-muted)] mb-6">
        Rails 8.1 Engine Template
      </span>
      <h1 class="text-5xl font-extrabold tracking-tight leading-tight mb-6">
        Ship engines faster with<br>
        <span style="color: var(--tc-primary)">TudlaAccounting</span>
      </h1>
      <p class="text-lg text-[var(--tc-text-muted)] mb-10 max-w-xl mx-auto">
        A production-ready mountable engine pre-configured with the Solid trifecta,
        Tailwind CSS v4, RSpec, and Importmap — focus on features, not boilerplate.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="#start"
           class="px-6 py-2.5 rounded-lg text-sm font-semibold text-[var(--tc-primary-fg)] transition-opacity hover:opacity-90"
           style="background-color: var(--tc-primary)">
          Get Started
        </a>
        <a href="#features"
           class="px-6 py-2.5 rounded-lg text-sm font-semibold border border-[var(--tc-border)] text-[var(--tc-text)] hover:bg-[var(--tc-surface)] transition-colors">
          See Features
        </a>
      </div>
    </div>
  </section>

  <%# ── Stats strip ────────────────────────────────────────── %>
  <section class="bg-[var(--tc-surface)] border-b border-[var(--tc-border)]">
    <div class="max-w-6xl mx-auto px-6 py-8 grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[var(--tc-border)]">
      <div class="py-6 md:py-0 md:px-8 text-center">
        <div class="text-3xl font-bold mb-1" style="color: var(--tc-primary)">4</div>
        <div class="text-sm font-medium mb-0.5">Databases</div>
        <div class="text-xs text-[var(--tc-text-muted)]">primary · queue · cache · cable</div>
      </div>
      <div class="py-6 md:py-0 md:px-8 text-center">
        <div class="text-3xl font-bold mb-1" style="color: var(--tc-accent)">RSpec</div>
        <div class="text-sm font-medium mb-0.5">Test Framework</div>
        <div class="text-xs text-[var(--tc-text-muted)]">+ FactoryBot + Capybara</div>
      </div>
      <div class="py-6 md:py-0 md:px-8 text-center">
        <div class="text-3xl font-bold mb-1" style="color: var(--tc-primary)">1 cmd</div>
        <div class="text-sm font-medium mb-0.5">Zero Config Clone</div>
        <div class="text-xs text-[var(--tc-text-muted)]">bin/clone_engine to get started</div>
      </div>
    </div>
  </section>

  <%# ── Features ───────────────────────────────────────────── %>
  <section id="features" class="py-20 bg-[var(--tc-bg)]">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-14">
        <h2 class="text-3xl font-bold mb-3">Everything wired, nothing wasted</h2>
        <p class="text-[var(--tc-text-muted)] max-w-lg mx-auto text-sm">Every component pre-configured and tested. Your engine is production-ready from commit one.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

        <div class="rounded-xl border border-[var(--tc-border)] bg-[var(--tc-surface)] p-6">
          <div class="size-9 rounded-lg flex items-center justify-center mb-4" style="background-color: color-mix(in oklch, var(--tc-primary) 12%, transparent)">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--tc-primary)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
          </div>
          <h3 class="font-semibold mb-1.5">Solid Queue</h3>
          <p class="text-sm text-[var(--tc-text-muted)]">SQL-backed background jobs. No Redis required — runs on your existing database.</p>
        </div>

        <div class="rounded-xl border border-[var(--tc-border)] bg-[var(--tc-surface)] p-6">
          <div class="size-9 rounded-lg flex items-center justify-center mb-4" style="background-color: color-mix(in oklch, var(--tc-accent) 12%, transparent)">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--tc-accent)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>
          </div>
          <h3 class="font-semibold mb-1.5">Solid Cache</h3>
          <p class="text-sm text-[var(--tc-text-muted)]">Database-backed caching layer. Persistent, scalable, zero extra infrastructure.</p>
        </div>

        <div class="rounded-xl border border-[var(--tc-border)] bg-[var(--tc-surface)] p-6">
          <div class="size-9 rounded-lg flex items-center justify-center mb-4" style="background-color: color-mix(in oklch, var(--tc-primary) 12%, transparent)">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--tc-primary)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="font-semibold mb-1.5">Solid Cable</h3>
          <p class="text-sm text-[var(--tc-text-muted)]">Database-backed Action Cable adapter. Real-time features without a separate pub/sub service.</p>
        </div>

        <div class="rounded-xl border border-[var(--tc-border)] bg-[var(--tc-surface)] p-6">
          <div class="size-9 rounded-lg flex items-center justify-center mb-4" style="background-color: color-mix(in oklch, var(--tc-accent) 12%, transparent)">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--tc-accent)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
          </div>
          <h3 class="font-semibold mb-1.5">Tailwind CSS v4</h3>
          <p class="text-sm text-[var(--tc-text-muted)]">Engine styles use pure Tailwind v4. Compatible with DaisyUI in the host app but never dependent on it.</p>
        </div>

        <div class="rounded-xl border border-[var(--tc-border)] bg-[var(--tc-surface)] p-6">
          <div class="size-9 rounded-lg flex items-center justify-center mb-4" style="background-color: color-mix(in oklch, var(--tc-primary) 12%, transparent)">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--tc-primary)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="font-semibold mb-1.5">Namespace Isolation</h3>
          <p class="text-sm text-[var(--tc-text-muted)]">Full <code class="font-mono text-xs px-1 py-0.5 rounded bg-[var(--tc-code-bg)]">isolate_namespace TudlaAccounting</code> — the engine never pollutes the host app.</p>
        </div>

        <div class="rounded-xl border border-[var(--tc-border)] bg-[var(--tc-surface)] p-6">
          <div class="size-9 rounded-lg flex items-center justify-center mb-4" style="background-color: color-mix(in oklch, var(--tc-accent) 12%, transparent)">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--tc-accent)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="font-semibold mb-1.5">Clone &amp; Go</h3>
          <p class="text-sm text-[var(--tc-text-muted)]">One script renames every file, class, and reference. New namespaced engine in seconds.</p>
        </div>

      </div>
    </div>
  </section>

  <%# ── Stack table ─────────────────────────────────────────── %>
  <section id="stack" class="py-20 bg-[var(--tc-bg-subtle)] border-t border-[var(--tc-border)]">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-3">The full stack</h2>
        <p class="text-[var(--tc-text-muted)] text-sm">Opinionated defaults. All open source.</p>
      </div>
      <div class="rounded-xl border border-[var(--tc-border)] overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-[var(--tc-surface)] border-b border-[var(--tc-border)] text-left text-xs font-semibold uppercase tracking-wider text-[var(--tc-text-muted)]">
              <th class="px-5 py-3">Layer</th>
              <th class="px-5 py-3">Technology</th>
              <th class="px-5 py-3">Purpose</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--tc-border)]">
            <% [
              ["Framework",        "Rails 8.1",         "Mountable engine foundation",           "--tc-primary"],
              ["Jobs",             "Solid Queue",        "Background processing",                  "--tc-accent"],
              ["Cache",            "Solid Cache",        "Database-backed caching",                "--tc-accent"],
              ["WebSockets",       "Solid Cable",        "Action Cable adapter",                   "--tc-accent"],
              ["Styling (engine)", "Tailwind CSS v4",   "Utility-first, no DaisyUI dep",          "--tc-primary"],
              ["JavaScript",       "Importmap Rails",   "No bundler required",                    "--tc-primary"],
              ["Testing",          "RSpec",             "+ FactoryBot + Capybara",                "--tc-accent"],
              ["Lint",             "RuboCop",           "rubocop-rails-omakase style",            "--tc-text-muted"],
            ].each do |layer, tech, purpose, color| %>
              <tr class="bg-[var(--tc-surface)] even:bg-[var(--tc-bg-subtle)]">
                <td class="px-5 py-3 text-[var(--tc-text-muted)]"><%= layer %></td>
                <td class="px-5 py-3 font-medium" style="color: var(<%= color %>)"><%= tech %></td>
                <td class="px-5 py-3 text-[var(--tc-text-muted)]"><%= purpose %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <%# ── Get Started ─────────────────────────────────────────── %>
  <section id="start" class="py-20 bg-[var(--tc-bg)] border-t border-[var(--tc-border)]">
    <div class="max-w-2xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-3">Get started in minutes</h2>
        <p class="text-[var(--tc-text-muted)] text-sm">Clone the template, rename the namespace, ship.</p>
      </div>
      <ol class="space-y-6">
        <% [
          ["Clone the engine",
           "bin/clone_engine /path/to/tudla_accounting MyEngine"],
          ["Start the container & set up the DB",
           "docker compose up -d\ndocker compose exec rails bash -lc 'bin/setup'"],
          ["Run the test suite",
           "docker compose exec rails bash -lc 'RAILS_ENV=test bundle exec rspec'"],
          ["Mount in your host app",
           "# config/routes.rb\nmount MyEngine::Engine => \"/my_engine\""],
        ].each_with_index do |(title, code), i| %>
          <li class="flex gap-4">
            <div class="shrink-0 size-7 rounded-full flex items-center justify-center text-xs font-bold text-[var(--tc-primary-fg)]"
                 style="background-color: var(--tc-primary)">
              <%= i + 1 %>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-semibold mb-2"><%= title %></p>
              <div class="rounded-lg bg-[var(--tc-code-bg)] border border-[var(--tc-border)] px-4 py-3 font-mono text-xs text-[var(--tc-text)] overflow-x-auto whitespace-pre"><%= code %></div>
            </div>
          </li>
        <% end %>
      </ol>
    </div>
  </section>

  <%# ── Footer ─────────────────────────────────────────────── %>
  <footer class="border-t border-[var(--tc-border)] bg-[var(--tc-bg-subtle)] py-6 text-center text-xs text-[var(--tc-text-muted)]">
    TudlaAccounting &mdash; MIT License &middot; Built with Rails 8.1 &amp; Tailwind CSS v4
  </footer>

</div>

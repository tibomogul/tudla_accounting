<%# locals: (row:) %>
<%# When a row's certificate came in, or waiting for it, with the button to change that. %>
<div class="flex flex-wrap items-center gap-2" data-certificate="<%= row.certificate_received? ? "received" : "waiting" %>">
  <% if row.certificate_received? %>
    <span>Received <%= tc_date(row.certificate_received_on) %></span>
    <% if tc_can?(:post) %>
      <%= form_with url: unmark_withholding_certificate_path(row) do |form| %><%= form.submit "Unmark", class: "tc-btn tc-btn-ghost" %><% end %>
    <% end %>
  <% elsif row.reversed? %>
    <span class="tc-muted">Reversed</span>
  <% elsif tc_can?(:post) %>
    <%= form_with url: mark_withholding_certificate_path(row), class: "flex items-center gap-2" do |form| %>
      <%= form.date_field :on, value: Date.current, required: true, class: "tc-input", aria: { label: "Certificate received on" } %>
      <%= form.submit "Mark received", class: "tc-btn tc-btn-secondary" %>
    <% end %>
  <% else %>
    <span class="tc-muted">Waiting</span>
  <% end %>
</div>

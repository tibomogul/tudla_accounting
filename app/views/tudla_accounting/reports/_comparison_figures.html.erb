<%# locals: (comparison:, figures:) %>
<%# Figures below the sections, e.g. [[:net_profit, "Net profit", true]] (label, then whether it's bold). %>
<% change = comparison.periods.size == 2 && @compare != "months" %>
<div class="tc-card overflow-x-auto">
  <table class="tc-table">
    <thead>
      <tr>
        <th><span class="sr-only">Figure</span></th>
        <% comparison.periods.each do |period| %><th class="tc-num whitespace-nowrap"><%= comparison_label(period, @compare) %></th><% end %>
        <% if change %><th class="tc-num">Change</th><th class="tc-num">%</th><% end %>
      </tr>
    </thead>
    <tbody>
      <% figures.each do |figure, label, strong| %>
        <% amounts = comparison.values(figure) %>
        <tr class="<%= "font-semibold" if strong %>" data-total="<%= figure %>">
          <td><%= label %></td>
          <% amounts.each do |amount| %><td class="tc-num"><%= tc_money(amount) %></td><% end %>
          <% if change %><td class="tc-num"><%= tc_money(amounts[0] - amounts[1]) %></td><td class="tc-num tc-muted"><%= comparison_percent(amounts) %></td><% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

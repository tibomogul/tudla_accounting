<%# locals: (url:, period:, label: "Period", compare: false) %>
<%= form_with url: url, method: :get, class: "flex flex-wrap items-end gap-2" do |form| %>
  <div>
    <%= form.label :period_id, label, class: "tc-label" %>
    <%= form.select :period_id, @choices.map { |choice| [ (choice.root? ? "Year #{tc_period_label(choice)}" : "#{tc_period_label(choice)} (to #{tc_date(choice.thru_date)})"), choice.id ] },
                    { selected: period.id }, class: "tc-input" %>
  </div>
  <% if compare %>
    <div>
      <%= form.label :compare, "Compare with", class: "tc-label" %>
      <%= form.select :compare, [ [ "Nothing", "" ] ] + TudlaAccounting::ReportsController::COMPARISONS.map { |key, name| [ name, key ] },
                      { selected: @compare }, class: "tc-input" %>
    </div>
  <% end %>
  <%= form.submit "Show", class: "tc-btn tc-btn-secondary", name: nil %>
<% end %>

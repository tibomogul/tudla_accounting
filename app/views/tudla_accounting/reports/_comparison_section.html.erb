<%# locals: (comparison:, category:, total_label: nil) %>
<% rows = comparison.rows(category) %>
<% columns = comparison.periods.size %>
<% change = columns == 2 && @compare != "months" %>
<section class="tc-card overflow-x-auto" aria-labelledby="section-<%= category %>">
  <table class="tc-table">
    <thead>
      <tr>
        <th id="section-<%= category %>"><%= TudlaAccounting::ReportsHelper::SECTION_TITLES.fetch(category) %></th>
        <% comparison.periods.each do |period| %><th class="tc-num whitespace-nowrap"><%= comparison_label(period, @compare) %></th><% end %>
        <% if change %><th class="tc-num">Change</th><th class="tc-num">%</th><% end %>
      </tr>
    </thead>
    <tbody>
      <% if rows.empty? %>
        <tr><td colspan="<%= columns + 1 + (change ? 2 : 0) %>" class="tc-muted">Nothing to report.</td></tr>
      <% end %>
      <% rows.each do |row| %>
        <tr>
          <td><div style="padding-left: <%= row.depth * 1.25 %>rem" class="<%= "font-semibold" if row.depth.zero? %>">
            <span class="font-mono tc-muted mr-2"><%= row.account.code %></span><%= report_account_link(row.account, comparison.periods.first) %>
          </div></td>
          <% row.amounts.each do |amount| %><td class="tc-num"><%= tc_money(amount) %></td><% end %>
          <% if change %><td class="tc-num"><%= tc_money(row.amounts[0] - row.amounts[1]) %></td><td class="tc-num tc-muted"><%= comparison_percent(row.amounts) %></td><% end %>
        </tr>
      <% end %>
      <% totals = comparison.total(category) %>
      <tr class="font-semibold" data-total="<%= category %>">
        <td><%= total_label || "Total #{TudlaAccounting::ReportsHelper::SECTION_TITLES.fetch(category).downcase}" %></td>
        <% totals.each do |amount| %><td class="tc-num"><%= tc_money(amount) %></td><% end %>
        <% if change %><td class="tc-num"><%= tc_money(totals[0] - totals[1]) %></td><td class="tc-num tc-muted"><%= comparison_percent(totals) %></td><% end %>
      </tr>
    </tbody>
  </table>
</section>

<% party_name = TudlaAccounting::PartyStatement::PARTY_NAMES.fetch(@type) %>
<% chosen = @statement && TudlaAccounting::PartyStatement.key(@statement.party) %>
<%= tc_page_header "Statements", subtitle: "A customer's or supplier's account with #{accounting_organization.name}, to send them" do %>
  <%= link_to "All #{party_name.downcase.pluralize}", reports_statements_path(type: @type, from: @from, thru: @thru, show: (@open_items ? "open_items" : nil)),
              class: "tc-btn tc-btn-ghost print:hidden" %>
  <% if @statement %><%= render "download" %><% end %>
<% end %>

<%= render "statement_form", url: reports_statement_path, chosen: chosen %>

<% if @statement.nil? %>
  <div class="tc-card tc-card-body tc-muted">
    <%= @parties.empty? ? "No #{party_name.downcase}s have #{@type == :receivable ? "invoices" : "bills"} yet." : "Choose a #{party_name.downcase} to see their statement." %>
  </div>
<% else %>
  <%= render "party_statement", statement: @statement, open_items: @open_items %>
<% end %>

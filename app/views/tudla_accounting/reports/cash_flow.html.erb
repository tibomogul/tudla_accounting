<%= tc_page_header "Cash flow", subtitle: (@report ? "#{tc_date(@from.from_date)} to #{tc_date(@thru.thru_date)}, #{@report.flow_method} method" : nil) do %>
  <% if @report %>
    <%= form_with url: reports_cash_flow_path, method: :get, class: "flex flex-wrap items-end gap-2" do |form| %>
      <div><%= form.label :from_id, "From", class: "tc-label" %><%= form.select :from_id, @months.map { |month| [ tc_period_label(month), month.id ] }, { selected: @from.id }, class: "tc-input" %></div>
      <div><%= form.label :thru_id, "To", class: "tc-label" %><%= form.select :thru_id, @months.map { |month| [ tc_period_label(month), month.id ] }, { selected: @thru.id }, class: "tc-input" %></div>
      <div><%= form.label :cash_account_ids, "Cash accounts", class: "tc-label" %>
        <%= form.select :cash_account_ids, @accounts.map { |account| [ account.code_with_name, account.id ] }, { selected: @report.cash_accounts.map(&:id) },
                        multiple: true, size: 3, class: "tc-input min-w-64" %></div>
      <div><%= form.label :method, "Method", class: "tc-label" %>
        <%= form.select :method, [ [ "Direct", "direct" ], [ "Indirect", "indirect" ] ], { selected: @report.flow_method }, class: "tc-input" %></div>
      <%= form.submit "Show", class: "tc-btn tc-btn-secondary", name: nil %>
    <% end %>
  <% end %>
<% end %>

<% if @report.nil? %>
  <%= render "no_periods" %>
<% elsif !@report.configured? %>
  <div class="tc-card tc-card-body text-center">
    <p class="tc-muted">Choose the cash accounts above (each includes the accounts beneath it), or set <code class="text-xs">cash_account_codes</code> in the engine's settings.</p>
  </div>
<% else %>
  <div class="tc-card overflow-x-auto">
    <table class="tc-table">
      <tbody>
        <tr class="font-semibold"><td>Cash at <%= tc_date(@from.from_date) %></td><td class="tc-num" data-total="opening"><%= tc_money(@report.opening) %></td></tr>
        <% { "operating" => "Operating activities", "investing" => "Investing activities", "financing" => "Financing activities" }.each do |activity, title| %>
          <tr><th colspan="2" class="text-left" id="flow-<%= activity %>"><%= title %></th></tr>
          <% if @report.sections[activity].empty? %>
            <tr><td colspan="2" class="tc-muted">No cash moved.</td></tr>
          <% end %>
          <% @report.sections[activity].each do |row| %>
            <tr>
              <td class="pl-6"><%= row.account ? link_to(row.account.code_with_name, account_path(row.account, year_id: @thru.root_id), class: "underline") : row.label %><%= tag.span(" (change in the balance)", class: "tc-muted text-xs") if row.account && @report.flow_method == :indirect %></td>
              <td class="tc-num"><%= tc_money(row.amount) %></td>
            </tr>
          <% end %>
          <tr class="font-semibold"><td>Net cash from <%= activity %> activities</td><td class="tc-num" data-total="<%= activity %>"><%= tc_money(@report.total(activity)) %></td></tr>
        <% end %>
        <tr class="font-semibold"><td>Net change in cash</td><td class="tc-num" data-total="net_change"><%= tc_money(@report.net_change) %></td></tr>
        <tr class="font-semibold"><td>Cash at <%= tc_date(@thru.thru_date) %></td><td class="tc-num" data-total="closing"><%= tc_money(@report.closing) %></td></tr>
      </tbody>
    </table>
  </div>
  <p class="mt-3">
    <% if @report.reconciles? %>
      <%= tc_badge "The change in cash is fully explained", tone: :success %>
    <% else %>
      <%= tc_badge "Unexplained difference of #{(@report.closing - @report.opening - @report.net_change).format(symbol: false)}", tone: :danger %>
    <% end %>
  </p>
  <p class="tc-hint mt-2">Cash is <%= @report.cash_accounts.map(&:code_with_name).to_sentence %> and the accounts beneath them. Each account's activity is set on the account (equity defaults to financing, the rest to operating).</p>
<% end %>

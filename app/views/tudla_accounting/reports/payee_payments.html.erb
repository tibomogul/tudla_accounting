<%= tc_page_header "Payments with tax withheld, by payee", subtitle: (@report ? "#{tc_date(@from.from_date)} to #{tc_date(@thru.thru_date)}" : nil) do %>
  <% if @report %>
    <%= render "withholding_form", url: reports_payee_payments_path %>
    <%= render "download" %>
    <% if TudlaAccounting.pdf? && @report.payees.any? %>
      <%= link_to "All payment summaries", reports_payee_payments_path(format: :pdf, from_id: @from.id, thru_id: @thru.id), class: "tc-btn tc-btn-ghost print:hidden", data: { turbo: false } %>
    <% end %>
  <% end %>
<% end %>

<% if @report.nil? %>
  <%= render "no_periods" %>
<% elsif !@report.any_codes? %>
  <div class="tc-card tc-card-body text-center">
    <p class="tc-muted">No withholding codes are withheld when a supplier is paid.<% if tc_can?(:administer) %> <%= link_to "Add one", withholding_codes_path, class: "underline" %>, such as Australia's no-ABN withholding.<% end %></p>
  </div>
<% else %>
  <p class="tc-hint mb-4">Tax withheld under codes withheld when the supplier is paid, such as when no ABN is quoted. The gross payment is what was paid before the tax. A voided payment counts in the month it was voided. Each payee's payment summary lists its payments, for you to sign and give them.</p>
  <% missing = @report.missing_addresses %>
  <% if missing.any? %>
    <div class="tc-alert tc-alert-warning mb-4" role="alert" data-missing-address>No address for <%= missing.to_sentence.delete_suffix(".") %>. Add it on the contact before reporting.</div>
  <% end %>
  <section class="tc-card overflow-x-auto mb-4" aria-label="Payees">
    <table class="tc-table">
      <% pdf = TudlaAccounting.pdf? %>
      <thead><tr><th>Payee</th><th>Address</th><th>Code</th><th class="tc-num">Gross payment</th><th class="tc-num">Tax withheld</th><% if pdf %><th><span class="sr-only">Payment summary</span></th><% end %></tr></thead>
      <tbody>
        <% if @report.payees.empty? %><tr><td colspan="<%= pdf ? 6 : 5 %>" class="tc-muted text-center">Nothing withheld in these months.</td></tr><% end %>
        <% @report.payees.each do |payee| %>
          <tr data-payee-row><td><%= link_to payee.contact.name, contact_path(payee.contact), class: "underline" %></td>
            <td class="text-sm"><%= payee.contact.full_address ? simple_format(payee.contact.full_address, {}, wrapper_tag: "span") : tag.span("No address", class: "tc-negative") %></td>
            <td class="font-mono"><%= payee.codes.map(&:code).join(", ") %></td>
            <td class="tc-num"><%= tc_money(payee.gross) %></td><td class="tc-num"><%= tc_money(payee.withheld) %></td>
            <% if pdf %><td class="whitespace-nowrap"><%= link_to "Payment summary", reports_payee_payments_path(format: :pdf, from_id: @from.id, thru_id: @thru.id, contact_id: payee.contact.id),
                                                      class: "underline text-sm", data: { turbo: false }, aria: { label: "Payment summary for #{payee.contact.name}" } %></td><% end %></tr>
        <% end %>
        <tr class="font-semibold"><td colspan="3">Total</td><td class="tc-num" data-total="gross"><%= tc_money(@report.total_gross) %></td><td class="tc-num" data-total="withheld"><%= tc_money(@report.total_withheld) %></td><% if pdf %><td></td><% end %></tr>
      </tbody>
    </table>
  </section>
  <% if @report.not_withheld.any? %>
    <section class="tc-card overflow-x-auto mb-4" aria-labelledby="not-withheld" data-not-withheld>
      <h2 id="not-withheld" class="tc-card-body tc-card-title pb-0">Paid without withholding</h2>
      <p class="tc-card-body tc-hint py-0">Payments to suppliers whose code is withheld on payment that had nothing withheld, or not all of it, with the reason each keeps. Check each reason is backed by your records, such as the supplier's statement.</p>
      <table class="tc-table">
        <thead><tr><th>Date</th><th>Payee</th><th class="tc-num">Paid</th><th>Why nothing was withheld</th></tr></thead>
        <tbody>
          <% @report.not_withheld.each do |payment| %>
            <tr data-not-withheld-row><td class="whitespace-nowrap"><%= link_to tc_date(payment.paid_on), payment_path(payment), class: "underline" %></td>
              <td><%= payment.contact.name %></td><td class="tc-num"><%= tc_money(payment.amount) %></td>
              <td class="<%= "tc-negative" if payment.not_withheld_reason == "No reason given" %>"><%= payment.not_withheld_reason %></td></tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>
  <%= render "withholding_checks", report: @report, direction: "from_supplier" %>
<% end %>

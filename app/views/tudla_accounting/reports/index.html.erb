<%= tc_page_header "Reports" %>
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% [ [ "Balance sheet", reports_balance_sheet_path, "Assets, liabilities and equity at the end of a month." ],
       [ "Profit and loss", reports_profit_and_loss_path, "Income and expenses for a year or a month." ],
       [ "Trial balance", reports_trial_balance_path, "Every account's balance in debit and credit columns, to check the books balance." ],
       [ "Receivables aging", reports_receivables_path, "What customers owe, by how overdue it is." ],
       [ "Payables aging", reports_payables_path, "What is owed to suppliers, by how overdue it is." ],
       [ "Tax return", reports_tax_return_path, "A BAS, VAT return or another form's boxes, filled from the tax codes and accounts mapped to them." ],
       [ "Statements", reports_statement_path, "A customer's or supplier's account over some dates, or what they still owe, to print or send." ],
       [ "Tax summary", reports_tax_path, "Tax collected on sales and paid on purchases, by tax code, for a run of months." ],
       [ "Profit and loss by dimension", reports_by_dimension_path, "Income and expenses split by department, project or another dimension." ],
       [ "Cash flow", reports_cash_flow_path, "Cash in and out from operating, investing and financing activities." ],
       [ "Budgets", budgets_path, "Planned income and expenses for a year, month by month, typed in or uploaded as a spreadsheet." ],
       [ "General ledger", reports_general_ledger_path, "Every posted line, account by account, with running balances; downloadable as CSV." ],
       [ "Books of accounts", reports_books_path, "The journals and ledger in numbered pages of 30 rows, with page totals, to print and bind (the BIR's loose-leaf books)." ],
       [ "Summary list of sales", reports_sales_list_path, "Sales to each customer by month, exempt, zero-rated and VATable, for the BIR's SLSP." ],
       [ "Summary list of purchases", reports_purchases_list_path, "Purchases from each supplier by month, split into services, capital goods and other goods, for the BIR's SLSP." ],
       *(@withholding ? [ [ "Withholding summary", reports_withholding_path, "Tax withheld by code and month, against the accounts, for the 0619-E and 1601-EQ." ],
                          [ "Tax withheld from suppliers (QAP)", reports_qap_path, "Each supplier's income and tax by code for a quarter." ],
                          [ "Certificates to suppliers (2307)", reports_supplier_certificates_path, "A BIR Form 2307 for each supplier tax was withheld from in a quarter, to print and sign." ],
                          [ "Tax withheld from you (SAWT)", reports_sawt_path, "Each customer's income and tax by code, with certificates received." ] ] : []) ].each do |title, path, description| %>
    <%= link_to path, class: "tc-card tc-card-body block hover:border-[var(--tc-primary)]" do %>
      <p class="font-semibold"><%= title %></p>
      <p class="tc-muted text-sm mt-1"><%= description %></p>
    <% end %>
  <% end %>
</div>

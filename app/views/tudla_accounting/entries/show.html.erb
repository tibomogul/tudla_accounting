<%= tc_page_header @entry.particulars, subtitle: [ @entry.number_label, "Dated #{tc_date(@entry.transacted_at)}" ].compact.join(" · ") do %>
  <% if @entry.draft? %>
    <% if tc_can?(:post) %><%= button_to "Post", post_entry_path(@entry), class: "tc-btn" %><% end %>
    <% if tc_can?(:record) %>
      <%= link_to "Edit", edit_entry_path(@entry), class: "tc-btn tc-btn-secondary" %>
      <%= button_to "Delete", entry_path(@entry), method: :delete, class: "tc-btn tc-btn-danger",
                    form: { data: { controller: "confirm", confirm_message_value: "Delete this draft?", action: "submit->confirm#ask" } } %>
    <% end %>
  <% end %>
  <% if tc_can?(:record) %><%= link_to "Make recurring", new_recurring_entry_path(entry_id: @entry.id), class: "tc-btn tc-btn-ghost" %><% end %>
<% end %>

<div class="flex flex-wrap items-center gap-2 mb-4">
  <%= entry_status_badge(@entry) %>
  <% if @entry.draft? && @entry.reverse_on %>
    <span class="tc-muted text-sm" data-reverse-on>Reverses automatically on <%= tc_date(@entry.reverse_on) %></span>
  <% end %>
  <% if @entry.reference %>
    <span class="tc-muted text-sm">Reference <%= @entry.reference %></span>
  <% end %>
  <% if @entry.related.is_a?(TudlaAccounting::Entry) %>
    <span class="tc-muted text-sm">Related to <%= link_to entry_title(@entry.related), entry_path(@entry.related), class: "underline" %></span>
  <% end %>
  <% if (reversal = @entry.reversal) %>
    <span class="tc-muted text-sm">Reversed by <%= link_to entry_title(reversal), entry_path(reversal), class: "underline" %></span>
  <% end %>
  <% if @entry.source.is_a?(TudlaAccounting::Document) %>
    <span class="tc-muted text-sm">Posted for <%= link_to @entry.source.title, document_path(@entry.source), class: "underline" %></span>
  <% elsif @entry.source.is_a?(TudlaAccounting::Payment) %>
    <span class="tc-muted text-sm">Posted for the <%= link_to @entry.source.title.downcase_first, payment_path(@entry.source), class: "underline" %></span>
  <% elsif @entry.source.is_a?(TudlaAccounting::RecurringEntry) %>
    <span class="tc-muted text-sm">Made from the recurring entry <%= link_to @entry.source.name, recurring_entry_path(@entry.source), class: "underline" %></span>
  <% elsif @entry.source_type.present? %>
    <span class="tc-muted text-sm">From <%= @entry.source_type %> #<%= @entry.source_id %></span>
  <% end %>
</div>

<div class="tc-card overflow-x-auto mb-6">
  <table class="tc-table">
    <thead><tr><th>Account</th><th class="tc-num">Debit</th><th class="tc-num">Credit</th></tr></thead>
    <tbody>
      <% @entry.details.sort_by { |line| line.debit? ? 0 : 1 }.each do |line| %>
        <tr>
          <td>
            <%= link_to line.account.code_with_name, account_path(line.account) %>
            <% if line.description %><div class="text-sm" data-description><%= line.description %></div><% end %>
            <% line.tags.each do |tag| %>
              <span class="tc-muted text-xs ml-2" data-tag><%= tag.dimension_value.label %></span>
            <% end %>
            <% if line.tax_code %>
              <span class="tc-muted text-xs ml-2" data-tax="<%= line.tax_role %>"><%= line.tax_tax? ? "#{line.tax_code.code} tax" : "taxed #{line.tax_code.label}" %></span>
            <% end %>
            <% if line.foreign_exchange %>
              <span class="tc-muted text-xs ml-2"><%= tc_money_text(line.foreign_exchange.foreign_amount) %> at <%= line.foreign_exchange.rate.to_s("F") %></span>
            <% end %>
          </td>
          <td class="tc-num"><%= tc_money(line.amount) if line.debit? %></td>
          <td class="tc-num"><%= tc_money(line.amount) if line.credit? %></td>
        </tr>
      <% end %>
      <tr class="font-semibold">
        <td>Total</td>
        <td class="tc-num"><%= tc_money(entry_total(@entry)) %></td>
        <td class="tc-num"><%= tc_money(@entry.details.select(&:credit?).sum(Money.new(0, accounting_organization.currency), &:amount)) %></td>
      </tr>
    </tbody>
  </table>
</div>

<% if TudlaAccounting.attachments? %>
  <%= render "tudla_accounting/attachments/list", record: @entry %>
<% end %>

<% if @entry.posted? %>
  <%= render "allocations", entry: @entry %>
  <% if !tc_can?(:post) %>
  <% elsif (blocker = @entry.reversal_blocker) %>
    <% unless @entry.reversal %><p class="tc-hint"><%= blocker %>.</p><% end %>
  <% else %>
    <%= form_with url: reverse_entry_path(@entry), class: "tc-card tc-card-body flex flex-wrap items-end gap-3 max-w-xl",
                  data: { controller: "confirm", confirm_message_value: "Reverse this entry?", action: "submit->confirm#ask" } do |form| %>
      <div>
        <%= form.label :on, "Reverse on", class: "tc-label" %>
        <%= form.date_field :on, value: Date.current, class: "tc-input" %>
      </div>
      <%= form.submit "Reverse", class: "tc-btn tc-btn-secondary" %>
      <p class="tc-hint w-full">Posts an entry with every line on the other side. Posted entries can't be edited.</p>
    <% end %>
  <% end %>
<% end %>

<p class="mt-6"><%= link_to "← All entries", entries_path, class: "tc-btn tc-btn-ghost" %></p>

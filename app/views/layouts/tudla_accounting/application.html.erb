<!DOCTYPE html>
<html>
<head>
  <title><%= [ content_for(:title), "Accounting" ].compact.join(" · ") %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <%#
    The engine's Tailwind CSS is compiled into the host application's tailwind.css
    via the @import stub in app/assets/builds/tailwind/tudla_accounting.css.
    Referencing "tailwind" here picks up that compiled output which includes all
    engine styles. The host app must run tailwindcss:build to generate this file.
  %>
  <%= stylesheet_link_tag "tailwind", media: "all" %>
  <%= javascript_importmap_tags "tudla_accounting/application" %>
  <script>
    (function() {
      try {
        var t = localStorage.getItem('theme');
        if (t) document.documentElement.setAttribute('data-theme', t);
      } catch (e) { /* storage unavailable: follow the OS theme */ }
    })();
  </script>
</head>
<body class="tc-app">
  <header class="border-b border-[var(--tc-border)] bg-[var(--tc-surface)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3">
      <div class="flex items-center gap-3">
        <%= link_to "Accounting", root_path, class: "text-lg font-bold tracking-tight" %>
        <% if accounting_organization %>
          <span class="tc-muted text-sm"><%= accounting_organization.name %></span>
          <%= tc_badge accounting_organization.currency %>
        <% end %>
      </div>
      <nav class="flex flex-wrap items-center gap-1" aria-label="Accounting">
        <% if accounting_organization %>
          <%= tc_nav_link "Dashboard", root_path %>
          <%= tc_nav_link "Accounts", accounts_path %>
          <%= tc_nav_link "Entries", entries_path %>
          <%= tc_nav_link "Reports", reports_path %>
          <%= tc_nav_link "Periods", periods_path %>
          <%= tc_nav_link "Setup", setup_path %>
        <% end %>
        <%= link_to "Back to app ↗", main_app.root_path, class: "tc-nav-link" %>
        <button type="button" class="tc-btn tc-btn-ghost tc-btn-sm" data-controller="theme" data-action="theme#toggle" aria-label="Switch theme">
          <svg data-theme-target="moon" aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg data-theme-target="sun" aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" hidden><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </nav>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <%= render "tudla_accounting/shared/flash" %>
    <%= yield %>
  </main>
</body>
</html>

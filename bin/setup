#!/usr/bin/env ruby

require 'fileutils'
require 'optparse'

# path to your application root.
APP_ROOT = File.expand_path('..', __dir__)

def setup(reset:)
  FileUtils.chdir APP_ROOT do
    # This script is a way to set up or update your development environment automatically.
    # This script is idempotent, so that you can run it at any time and get an expectable outcome.
    # Add necessary setup steps to this file.

    log '== Installing dependencies =='
    # system! "gem install bundler --conservative"
    system! 'bundle check || bundle install'

    # From the engine root (whose bin/rails names the dummy app's tasks app:db:*), where
    # the engine's migrations are visible too: loading the schema from spec/dummy wouldn't
    # record them, and they'd look pending.
    if reset
      log '== Recreating and seeding the development databases =='
      # Drops them (the test databases too, in development), recreates them from every
      # schema (primary, queue, cache, cable) and runs the seeds (Demo Co) once.
      system! 'bin/rails app:db:reset'
    else
      log '== Preparing the development databases =='
      # Creates, loads and seeds the databases that don't exist yet and migrates the rest;
      # keeps what's in them.
      system! 'bin/rails app:db:prepare'
    end

    log '== Removing old logs and tempfiles =='
    system! 'cd spec/dummy && bin/rails log:clear tmp:clear'

    # log '== Removing attachments =='
    # system! 'cd spec/dummy && bin/rake active_storage:remove_all'
  end

  log 'All set up.'
  log ''
  log 'To see commonly-needed commands, run:'
  log ''
  log '    bin/setup help'
  log ''
end

def help
  puts "Usage: #{$0}"
  puts ''
  puts 'Installs gems, prepares the dev databases (creating and seeding them'
  puts 'the first time), and generally prepares the app to be run locally'
  puts ''
  puts ' bin/setup --reset'
  puts '    # drop, recreate and reseed the dev databases'
  puts ''
  puts 'Other useful commands:'
  puts ''
  puts ' bin/dev'
  puts '    # run app locally'
  puts ''
  puts ' bin/setup help'
  puts '    # show this help'
  puts ''
end

# start of helpers

# It's helpful to know what messages came from this
# script, so we'll use log instead of `puts`
def log(message)
  puts "[ bin/setup ] #{message}"
end

# We don't want the setup method to have to do all this error
# checking, and we also want to explicitly log what we are
# executing. Thus, we use this method instead of Kernel#system
def system!(*args)
  log "Executing #{args}"
  if system(*args)
    log "#{args} succeeded"
  else
    log "#{args} failed"
    abort
  end
end

# end of helpers

reset = false
OptionParser.new do |parser|
  parser.on('-h', '--help') do
    help
    exit
  end
  parser.on('--reset') { reset = true }
end.parse!

if ARGV[0] == 'help'
  help
elsif !ARGV[0].nil?
  puts "Unknown argument: '#{ARGV[0]}'"
  exit 1
else
  setup(reset: reset)
end

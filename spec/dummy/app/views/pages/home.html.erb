<%# Hero %>
<section class="hero min-h-[70vh] bg-base-200">
  <div class="hero-content text-center py-20">
    <div class="max-w-2xl">
      <div class="badge badge-primary badge-outline mb-4">Rails 8.1 Engine Template</div>
      <h1 class="text-5xl font-extrabold tracking-tight mb-6">
        Ship engines faster with <span class="text-primary">TudlaAccounting</span>
      </h1>
      <p class="text-lg text-base-content/70 mb-8">
        A production-ready mountable Rails engine template pre-configured with the Solid trifecta,
        Tailwind CSS v4, DaisyUI, RSpec, and Importmap — so you can focus on building features, not boilerplate.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="#getting-started" class="btn btn-primary btn-lg">Get Started</a>
        <a href="#features" class="btn btn-outline btn-lg">See Features</a>
      </div>
    </div>
  </div>
</section>


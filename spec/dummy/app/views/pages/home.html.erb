<%# Features %>
<section id="features" class="py-20 bg-base-100">
  <div class="container mx-auto px-6">
    <div class="text-center mb-14">
      <h2 class="text-3xl font-bold mb-3">Everything you need, nothing you don't</h2>
      <p class="text-base-content/60 max-w-xl mx-auto">Every component is pre-wired so your engine is production-ready from the first commit.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

      <div class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body">
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
          </div>
          <h3 class="card-title text-base">Solid Queue</h3>
          <p class="text-sm text-base-content/60">SQL-backed background job processing. No Redis required — runs on your existing database.</p>
        </div>
      </div>

      <div class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body">
          <div class="w-10 h-10 rounded-lg bg-secondary/10 flex items-center justify-center mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>
          </div>
          <h3 class="card-title text-base">Solid Cache</h3>
          <p class="text-sm text-base-content/60">Database-backed caching layer. Persistent, scalable, and zero extra infrastructure.</p>
        </div>
      </div>

      <div class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body">
          <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="card-title text-base">Solid Cable</h3>
          <p class="text-sm text-base-content/60">Database-backed Action Cable adapter. Real-time features without a separate pub/sub service.</p>
        </div>
      </div>

      <div class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body">
          <div class="w-10 h-10 rounded-lg bg-info/10 flex items-center justify-center mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-info" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
          </div>
          <h3 class="card-title text-base">Tailwind CSS v4 + DaisyUI</h3>
          <p class="text-sm text-base-content/60">Engine uses pure Tailwind v4. Dummy app layers DaisyUI on top for rapid UI prototyping.</p>
        </div>
      </div>

      <div class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body">
          <div class="w-10 h-10 rounded-lg bg-success/10 flex items-center justify-center mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="card-title text-base">Namespace Isolation</h3>
          <p class="text-sm text-base-content/60">Full <code class="font-mono text-xs">isolate_namespace TudlaAccounting</code> so your engine never pollutes the host app.</p>
        </div>
      </div>

      <div class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body">
          <div class="w-10 h-10 rounded-lg bg-warning/10 flex items-center justify-center mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="card-title text-base">Clone & Go</h3>
          <p class="text-sm text-base-content/60">One script renames every file, class, and reference. New engine in seconds, not hours.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<%# Stack %>
<section id="stack" class="py-20 bg-base-200">
  <div class="container mx-auto px-6">
    <div class="text-center mb-14">
      <h2 class="text-3xl font-bold mb-3">The full stack</h2>
      <p class="text-base-content/60">Carefully chosen defaults. All open source.</p>
    </div>
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full max-w-3xl mx-auto">
        <thead>
          <tr>
            <th>Layer</th>
            <th>Technology</th>
            <th>Purpose</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Framework</td><td><span class="badge badge-primary">Rails 8.1</span></td><td>Mountable engine foundation</td></tr>
          <tr><td>Jobs</td><td><span class="badge badge-secondary">Solid Queue</span></td><td>Background processing</td></tr>
          <tr><td>Cache</td><td><span class="badge badge-secondary">Solid Cache</span></td><td>Database-backed caching</td></tr>
          <tr><td>WebSockets</td><td><span class="badge badge-secondary">Solid Cable</span></td><td>Action Cable adapter</td></tr>
          <tr><td>Styling (engine)</td><td><span class="badge badge-accent">Tailwind CSS v4</span></td><td>Utility-first, no DaisyUI dep</td></tr>
          <tr><td>Styling (dummy)</td><td><span class="badge badge-accent">DaisyUI</span></td><td>Component library for dev UI</td></tr>
          <tr><td>JavaScript</td><td><span class="badge badge-info">Importmap Rails</span></td><td>No bundler required</td></tr>
          <tr><td>Testing</td><td><span class="badge badge-success">RSpec</span></td><td>+ FactoryBot + Capybara</td></tr>
          <tr><td>Lint</td><td><span class="badge badge-warning">RuboCop</span></td><td>rubocop-rails-omakase style</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%# Getting Started %>
<section id="getting-started" class="py-20 bg-base-100">
  <div class="container mx-auto px-6 max-w-3xl">
    <div class="text-center mb-14">
      <h2 class="text-3xl font-bold mb-3">Get started in minutes</h2>
      <p class="text-base-content/60">Clone the template, rename the namespace, ship.</p>
    </div>
    <ul class="steps steps-vertical w-full gap-2">
      <li class="step step-primary">
        <div class="text-left ml-4">
          <p class="font-semibold">Clone the engine</p>
          <div class="mockup-code mt-2 text-sm">
            <pre><code>bin/clone_engine /path/to/tudla_accounting MyEngine</code></pre>
          </div>
        </div>
      </li>
      <li class="step step-primary">
        <div class="text-left ml-4">
          <p class="font-semibold">Start the container &amp; set up the DB</p>
          <div class="mockup-code mt-2 text-sm">
            <pre><code>docker compose up -d
docker compose exec rails bash -lc 'bin/setup'</code></pre>
          </div>
        </div>
      </li>
      <li class="step step-primary">
        <div class="text-left ml-4">
          <p class="font-semibold">Run the test suite</p>
          <div class="mockup-code mt-2 text-sm">
            <pre><code>docker compose exec rails bash -lc 'RAILS_ENV=test bundle exec rspec'</code></pre>
          </div>
        </div>
      </li>
      <li class="step">
        <div class="text-left ml-4">
          <p class="font-semibold">Start building</p>
          <p class="text-sm text-base-content/60 mt-1">Mount the engine in your host app and start shipping features.</p>
        </div>
      </li>
    </ul>
  </div>
</section>

<%# Footer %>
<footer class="footer footer-center p-6 bg-base-200 text-base-content/60 border-t border-base-200">
  <p>TudlaAccounting — MIT License · Built with Rails 8.1, Tailwind CSS v4 &amp; DaisyUI</p>
</footer>

<script>
  (function() {
    var checkbox = document.getElementById('theme-toggle');
    var html = document.documentElement;
    var current = localStorage.getItem('theme') || 'light';

    if (current === 'dark') checkbox.checked = true;

    checkbox.addEventListener('change', function() {
      var next = this.checked ? 'dark' : 'light';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  })();
</script>
